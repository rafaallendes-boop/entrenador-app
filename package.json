{
  "name": "entrenador-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "audit:prompt": "vitest run scripts/audit-prompt-tokens.test.ts --reporter=verbose",
    "loadtest:week-creator": "node scripts/loadtest-week-creator.mjs",
    "migrate:dry-run": "node scripts/migrate-dry-run.mjs",
    "e2e:dev": "node scripts/e2e-coach-test.mjs",
    "e2e:dev:headed": "node scripts/e2e-coach-test.mjs --headed",
    "e2e:dev:quick": "node scripts/e2e-coach-test.mjs --quick",
    "e2e:dev:apply": "node scripts/e2e-coach-test.mjs --apply --headed",
    "e2e:dev:quality": "node scripts/e2e-coach-test.mjs --export-quality",
    "e2e:plan": "node scripts/e2e-plan-builder-test.mjs",
    "e2e:plan:headed": "node scripts/e2e-plan-builder-test.mjs --headed",
    "e2e:plan:generate": "node scripts/e2e-plan-builder-test.mjs --generate",
    "e2e:plan:generate:headed": "node scripts/e2e-plan-builder-test.mjs --generate --headed",
    "e2e:plan:generate:quality": "node scripts/e2e-plan-builder-test.mjs --generate --export-quality",
    "e2e:plan:accept": "node scripts/e2e-plan-builder-test.mjs --accept --headed"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.88.0",
