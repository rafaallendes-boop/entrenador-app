# Build de producción.
# CoachEngine ignora esta var en PROD — siempre usa ProxyProvider.
# Está aquí solo como documentación del comportamiento esperado.
VITE_AI_PROVIDER=proxy

# Obligatoria al compilar la app iOS. Configurar en .env.local o en el entorno
# de build con el origen HTTPS que publica las Netlify Functions.
VITE_API_BASE_URL=https://entrenadoralph.netlify.app/
